---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import { requireAuth, isSuperAdmin } from '../../lib/auth';

const user = requireAuth(Astro.cookies);
if (!user || !isSuperAdmin(user)) {
  return Astro.redirect('/auth/login');
}
---

<DashboardLayout title="Backup - Panel Admin" user={user}>
  <section class="mx-auto w-full max-w-5xl py-2 sm:py-4">
    <header class="mb-8 flex flex-col gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-4">
        <div class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 sm:flex">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <ellipse cx="12" cy="5" rx="8" ry="3" stroke-width="2" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5v14c0 1.657 3.582 3 8 3s8-1.343 8-3V5M4 12c0 1.657 3.582 3 8 3s8-1.343 8-3" />
          </svg>
        </div>
        <div>
          <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-blue-700">Administración del sistema</p>
          <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Backup de Base de Datos</h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600 sm:text-base">
            Genera un respaldo completo en formato <span class="font-semibold text-gray-700">.sql</span> y elige dónde almacenarlo.
            Cada archivo incluye la fecha y hora de generación.
          </p>
        </div>
      </div>
      <span class="inline-flex w-fit items-center gap-2 rounded-full border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-medium text-green-800">
        <span class="h-2 w-2 rounded-full bg-green-500"></span>
        Acceso Superadmin
      </span>
    </header>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
      <article class="flex min-h-[280px] flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md sm:p-7">
        <div class="mb-5 flex items-center justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </div>
          <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">En tu dispositivo</span>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">Descargar localmente</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-gray-600">
          Genera y descarga el archivo para guardarlo en tu equipo o en un medio de almacenamiento externo.
        </p>
        <div class="mt-5 border-t border-gray-100 pt-4">
          <p class="mb-3 text-xs text-gray-500">Formato SQL con fecha y hora en el nombre del archivo.</p>
          <button
            id="btnDownload"
            type="button"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
          >
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Descargar archivo .sql
          </button>
        </div>
      </article>

      <article class="flex min-h-[280px] flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md sm:p-7">
        <div class="mb-5 flex items-center justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
            </svg>
          </div>
          <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700">Almacenamiento R2</span>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">Guardar en servidor</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-gray-600">
          Guarda el respaldo en el almacenamiento seguro de R2, dentro de la carpeta
          <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs text-gray-700">backups/</span>.
        </p>
        <div class="mt-5 border-t border-gray-100 pt-4">
          <p class="mb-3 text-xs text-gray-500">El archivo queda almacenado en el servidor para futuras consultas.</p>
          <button
            id="btnUpload"
            type="button"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
          >
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            Generar y subir a R2
          </button>
        </div>
      </article>
    </div>

    <aside class="mt-6 flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-4 text-sm text-blue-900">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p>
        El respaldo incluye la estructura y los datos de todas las tablas de la base de datos. Guárdalo en un lugar protegido,
        ya que puede contener información sensible.
      </p>
    </aside>
  </section>
</DashboardLayout>

<script>
  import Swal from 'sweetalert2';

  const btnDownload = document.getElementById('btnDownload') as HTMLButtonElement;
  const btnUpload = document.getElementById('btnUpload') as HTMLButtonElement;

  function setLoading(button: HTMLButtonElement, loading: boolean, label: string) {
    button.disabled = loading;
    if (loading) {
      button.dataset.original = button.innerHTML;
      button.innerHTML = `<svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>${label}`;
    } else if (button.dataset.original) {
      button.innerHTML = button.dataset.original;
    }
  }

  function filenameFromHeader(header: string | null): string | null {
    if (!header) return null;
    const match = header.match(/filename="?([^"]+)"?/i);
    return match ? match[1] : null;
  }

  btnDownload.addEventListener('click', async () => {
    setLoading(btnDownload, true, 'Generando...');
    try {
      const res = await fetch('/api/admin/backup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'download' }),
      });

      if (!res.ok) {
        throw new Error('request-failed');
      }

      const blob = await res.blob();
      const filename = filenameFromHeader(res.headers.get('Content-Disposition')) || 'backup.sql';
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      Swal.fire({
        icon: 'success',
        title: 'Respaldo generado',
        text: `Archivo descargado: ${filename}`,
        confirmButtonColor: '#3B82F6',
      });
    } catch (error) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'No se pudo generar el respaldo. Intente nuevamente.',
        confirmButtonColor: '#3B82F6',
      });
    } finally {
      setLoading(btnDownload, false, '');
    }
  });

  btnUpload.addEventListener('click', async () => {
    const confirm = await Swal.fire({
      icon: 'question',
      title: 'Subir respaldo a R2',
      text: 'Se generará el respaldo y se subirá al servidor. ¿Deseas continuar?',
      showCancelButton: true,
      confirmButtonText: 'Sí, subir',
      cancelButtonText: 'Cancelar',
      confirmButtonColor: '#4F46E5',
      cancelButtonColor: '#6B7280',
    });
    if (!confirm.isConfirmed) return;

    setLoading(btnUpload, true, 'Subiendo...');
    try {
      const res = await fetch('/api/admin/backup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'upload' }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data?.message || 'request-failed');
      }

      Swal.fire({
        icon: 'success',
        title: 'Respaldo subido',
        html: `El respaldo se guardó en el servidor.<br><span class="text-sm text-gray-500">${data.data?.filename || ''}</span>`,
        confirmButtonColor: '#4F46E5',
      });
    } catch (error) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'No se pudo subir el respaldo. Intente nuevamente.',
        confirmButtonColor: '#4F46E5',
      });
    } finally {
      setLoading(btnUpload, false, '');
    }
  });
</script>
